# Copy file này thành .env rồi sửa cho đúng máy của bạn:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# KHÔNG commit file .env lên git (đã có trong .gitignore).

APP_NAME=KS25 Base API
ENVIRONMENT=development

# ---- MySQL ----
# Điền giống thông tin bạn dùng để kết nối trong MySQL Workbench
# (Workbench: chuột phải vào connection -> Edit Connection để xem Hostname/Port/Username).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Mật khẩu root bạn đặt lúc cài MySQL (XAMPP mặc định để trống)
DB_PASSWORD=123456@
DB_NAME=app_db

# ---- Google OAuth ----
# Giữ giá trị mẫu nếu không dùng đăng nhập Google; điền credentials thật để bật.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ---- Session ----
# Chỉ dùng giá trị mẫu cho local development; hãy thay bằng giá trị ngẫu nhiên.
# Tạo giá trị bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=local-development-only-change-me

# ---- JWT ----
# Recommended: set a stable secret to keep tokens valid across server restarts.
# If left unset, a new secret is generated each time the app starts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=

# ---- CORS ----
# Các địa chỉ frontend được phép gọi API, cách nhau bằng dấu phẩy.
# "*" = cho phép tất cả (tiện khi học/dev). Khi deploy thật hãy ghi rõ domain FE.
# Ví dụ: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
SESSION_SECRET_KEY=gameconnect_team7_session_secret_key_2026
FRONTEND_HOME_URL=http://127.0.0.1:5500/pages/home.html

